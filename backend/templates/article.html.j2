<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>{{ seo.meta_title }}</title>
  <meta name="description" content="{{ seo.meta_description }}">
</head>
<body>
  <h1>{{ article.title }}</h1>

  {% if article.key_takeaways %}
    <h2>Key takeaways</h2>
    <ul>
      {% for k in article.key_takeaways %}
        <li>{{ k }}</li>
      {% endfor %}
    </ul>
  {% endif %}

  {% for s in article.sections %}
    <h2>{{ s.heading }}</h2>
    {% for p in s.paragraphs %}
      <p>{{ p }}</p>
    {% endfor %}
  {% endfor %}

  <h2>Relevant links</h2>
  <ul>
    {% for l in article.relevant_links %}
      <li><a href="{{ l.url }}">{{ l.title }}</a></li>
    {% endfor %}
  </ul>
</body>
</html>
